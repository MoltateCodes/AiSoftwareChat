<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1200"
        Height="750"
        Background="#101318"
        FontFamily="Pally Variable"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <Grid>

        <!-- GRID LAYOUT -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="35*" />
            <ColumnDefinition Width="45*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- BACKGROUND -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,1">

                <GradientStop Color="#080B10"
                              Offset="0" />

                <GradientStop Color="#10151E"
                              Offset="0.5" />

                <GradientStop Color="#080B10"
                              Offset="1" />

            </LinearGradientBrush>
        </Grid.Background>

        <!-- GLASS AMBIENT LIGHTS -->

        <Ellipse Width="350"
                 Height="350"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="100,80,0,0"
                 Fill="#35D9467A"
                 Opacity="0.20">

            <Ellipse.Effect>
                <BlurEffect Radius="90" />
            </Ellipse.Effect>

        </Ellipse>

        <Ellipse Width="300"
                 Height="300"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,80,80,0"
                 Fill="#353B82F6"
                 Opacity="0.16">

            <Ellipse.Effect>
                <BlurEffect Radius="90" />
            </Ellipse.Effect>

        </Ellipse>

        <!-- TOP BAR -->
        <Border Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="15,10,15,10"
                CornerRadius="25">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">

                    <GradientStop Color="#D91A2029"
                                  Offset="0" />
                    <GradientStop Color="#C9141921"
                                  Offset="1" />

                </LinearGradientBrush>
            </Border.Background>

            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="25"
                                  ShadowDepth="6"
                                  Opacity="0.30" />
            </Border.Effect>

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Welcome to Dimension Solaria"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="SemiBold" />

                    <TextBlock Text="FROM MOLTATE WORLD"
                               Foreground="#7F8998"
                               FontSize="12"
                               Margin="0,2,0,0" />

                </StackPanel>

                <Button Grid.Column="1"
                        Width="42"
                        Height="42"
                        Content="⚙"
                        FontSize="20"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0" />

            </Grid>

        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Row="1"
              Grid.ColumnSpan="3">

            <Grid.ColumnDefinitions>
                <!-- Character list -->
                <ColumnDefinition Width="186" />

                <!-- 2D Character -->
                <ColumnDefinition Width="463*" />

                <!-- Chat -->
                <ColumnDefinition Width="551*" />

            </Grid.ColumnDefinitions>

            <!-- CHARACTER LIST -->
            <Border Grid.Column="0"
                    Margin="15,15,34,15"
                    CornerRadius="35"
                    BorderBrush="#20FFFFFF"
                    BorderThickness="1">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="#CC1B2029"
                                      Offset="0" />
                        <GradientStop Color="#B510141C"
                                      Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                      BlurRadius="25"
                                      ShadowDepth="6"
                                      Opacity="0.25" />
                </Border.Effect>

                <!-- KEEP YOUR EXISTING GRID HERE -->

                <Grid Margin="12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>


                    <!-- TITLE -->
                    <TextBlock Foreground="#7F8998"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="8,5,0,15"><Run Language="en-in"
                                                      Text="FRIENDS" /></TextBlock>


                    <!-- CHARACTER LIST -->
                    <StackPanel Grid.Row="1">


                        <!-- MIRA -->
                        <Border x:Name="MiraCharacterBorder"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="35"
                                RenderTransformOrigin="0.5,0.5"
                                Padding="10"
                                Margin="0,0,0,8"
                                Tag="MIRA"
                                Cursor="Hand"
                                MouseLeftButtonUp="Character_Click">



                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1"
                                                ScaleY="1" />
                            </Border.RenderTransform>

                            <Border.Style>
                                <Style TargetType="Border">

                                    <!-- NORMAL -->
                                    <Setter Property="Background"
                                            Value="Transparent" />

                                    <Style.Triggers>

                                        <!-- HOVER: SCALE UP -->
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- MOUSE LEAVES: SCALE BACK -->
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- CLICK: PRESS DOWN -->
                                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="0.94"
                                                                     Duration="0:0:0.08" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="0.94"
                                                                     Duration="0:0:0.08" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- CLICK: RELEASE -->
                                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Border.Style>

                            <Grid>

                                <Ellipse Width="50"
                                         Height="50"
                                         RenderOptions.BitmapScalingMode="HighQuality"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="-1,0,0,0">

                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/CharImg/mira_profile.png"
                                                    Stretch="UniformToFill" />
                                    </Ellipse.Fill>

                                </Ellipse>

                                <StackPanel Margin="55,0,0,0"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="MIRA"
                                               Foreground="#E8ECF2"
                                               FontSize="14"
                                               FontWeight="SemiBold" />

                                    <TextBlock Text="Online"
                                               Foreground="#6EE7A8"
                                               FontSize="11" />

                                </StackPanel>

                            </Grid>

                        </Border>


                        <!-- BYTE -->
                        <Border BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="35"
                                RenderTransformOrigin="0.5,0.5"
                                Padding="10"
                                Margin="0,0,0,8"
                                Tag="BYTE"
                                Cursor="Hand"
                                MouseLeftButtonUp="Character_Click">

                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1"
                                                ScaleY="1" />

                            </Border.RenderTransform>

                            <Border.Style>
                                <Style TargetType="Border">

                                    <!-- NORMAL -->
                                    <Setter Property="Background"
                                            Value="Transparent" />

                                    <Style.Triggers>

                                        <!-- HOVER: SCALE UP -->
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- MOUSE LEAVES: SCALE BACK -->
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- CLICK: PRESS DOWN -->
                                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="0.94"
                                                                     Duration="0:0:0.08" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="0.94"
                                                                     Duration="0:0:0.08" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- CLICK: RELEASE -->
                                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Border.Style>


                            <Grid>

                                <Ellipse Width="42"
                                         Height="42"
                                         RenderOptions.BitmapScalingMode="HighQuality"
                                         HorizontalAlignment="Left">

                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/CharImg/byte_profile.png"
                                                    Stretch="UniformToFill" />
                                    </Ellipse.Fill>

                                </Ellipse>

                                <StackPanel Margin="55,0,0,0"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="BYTE"
                                               Foreground="White"
                                               FontSize="14"
                                               FontWeight="SemiBold" />

                                    <TextBlock Text="Online"
                                               Foreground="#6EE7A8"
                                               FontSize="11" />

                                </StackPanel>

                            </Grid>

                        </Border>

                        <!-- NIX -->
                        <Border BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="35"
                                RenderTransformOrigin="0.5,0.5"
                                Padding="10"
                                Margin="0,0,0,8"
                                Tag="NIX"
                                Cursor="Hand"
                                MouseLeftButtonUp="Character_Click">

                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1"
                                                ScaleY="1" />
                            </Border.RenderTransform>

                            <Border.Style>
                                <Style TargetType="Border">

                                    <!-- NORMAL -->
                                    <Setter Property="Background"
                                            Value="Transparent" />

                                    <Style.Triggers>

                                        <!-- HOVER: SCALE UP -->
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- MOUSE LEAVES: SCALE BACK -->
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- CLICK: PRESS DOWN -->
                                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="0.94"
                                                                     Duration="0:0:0.08" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="0.94"
                                                                     Duration="0:0:0.08" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- CLICK: RELEASE -->
                                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Border.Style>


                            <Grid>

                                <Ellipse Width="42"
                                         Height="42"
                                         RenderOptions.BitmapScalingMode="HighQuality"
                                         HorizontalAlignment="Left">

                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/CharImg/nix_profile.png"
                                                    Stretch="UniformToFill" />
                                    </Ellipse.Fill>

                                </Ellipse>

                                <StackPanel Margin="55,0,0,0"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="NIX"
                                               Foreground="White"
                                               FontSize="14"
                                               FontWeight="SemiBold" />

                                    <TextBlock Text="Online"
                                               Foreground="#6EE7A8"
                                               FontSize="11" />

                                </StackPanel>

                            </Grid>

                        </Border>

                        <!-- R-01 -->
                        <Border BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="35"
                                RenderTransformOrigin="0.5,0.5"
                                Padding="10"
                                Margin="0,0,0,8"
                                Tag="R-01"
                                Cursor="Hand"
                                MouseLeftButtonUp="Character_Click">

                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1"
                                                ScaleY="1" />
                            </Border.RenderTransform>

                            <Border.Style>
                                <Style TargetType="Border">

                                    <!-- NORMAL -->
                                    <Setter Property="Background"
                                            Value="Transparent" />

                                    <Style.Triggers>

                                        <!-- HOVER: SCALE UP -->
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- MOUSE LEAVES: SCALE BACK -->
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- CLICK: PRESS DOWN -->
                                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="0.94"
                                                                     Duration="0:0:0.08" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="0.94"
                                                                     Duration="0:0:0.08" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- CLICK: RELEASE -->
                                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Border.Style>


                            <Grid>

                                <Ellipse Width="42"
                                         Height="42"
                                         RenderOptions.BitmapScalingMode="HighQuality"
                                         HorizontalAlignment="Left">

                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/CharImg/R-01_profile.png"
                                                    Stretch="UniformToFill" />
                                    </Ellipse.Fill>

                                </Ellipse>

                                <StackPanel Margin="55,0,0,0"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="R-01"
                                               Foreground="White"
                                               FontSize="14"
                                               FontWeight="SemiBold" />

                                    <TextBlock Text="Online"
                                               Foreground="#6EE7A8"
                                               FontSize="11" />

                                </StackPanel>

                            </Grid>

                        </Border>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- CHARACTER PANEL -->
            <Border Grid.Column="1"
                    Margin="15,15,15,15"
                    CornerRadius="35"
                    BorderBrush="#20FFFFFF"
                    BorderThickness="1">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">

                        <GradientStop Color="#D91B212B"
                                      Offset="0" />

                        <GradientStop Color="#C910141C"
                                      Offset="1" />

                    </LinearGradientBrush>
                </Border.Background>

                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                      BlurRadius="30"
                                      ShadowDepth="8"
                                      Opacity="0.30" />
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <Border Width="436"
                            Height="450"
                            CornerRadius="35"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="1">

                        <Border.Background>

                            <RadialGradientBrush Center="0.5,0.35"
                                                 RadiusX="0.8"
                                                 RadiusY="0.8">

                                <GradientStop Color="#D92D3545"
                                              Offset="0" />

                                <GradientStop Color="#C9161B24"
                                              Offset="1" />

                            </RadialGradientBrush>

                        </Border.Background>

                        <Border.Effect>
                            <DropShadowEffect Color="#000000"
                                              BlurRadius="30"
                                              ShadowDepth="8"
                                              Opacity="0.35" />
                        </Border.Effect>

                        <TextBlock Text="2D CHARACTER"
                                   Foreground="#596273"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                    </Border>

                    <TextBlock x:Name="CenterCharacterName"
                               Text="MIRA"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,15,0,0" />

                    <TextBlock Text="Neutral"
                               Foreground="#7F8998"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />

                </StackPanel>

            </Border>

            <!-- CHAT PANEL -->
            <Border Grid.Column="2"
                    Margin="0,15,15,15"
                    CornerRadius="35"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="1">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="0,1">

                        <GradientStop Color="#DD202733"
                                      Offset="0" />

                        <GradientStop Color="#C9141921"
                                      Offset="0.5" />

                        <GradientStop Color="#C90D1118"
                                      Offset="1" />

                    </LinearGradientBrush>
                </Border.Background>

                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                      BlurRadius="30"
                                      ShadowDepth="8"
                                      Opacity="0.35" />
                </Border.Effect>

                <Grid Margin="20">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="70" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="70" />
                    </Grid.RowDefinitions>

                    <!-- CHARACTER STATUS -->


                    <Border CornerRadius="35"
                            Padding="10"
                            BorderBrush="#20FFFFFF"
                            BorderThickness="1">

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">

                                <GradientStop Color="#CC2A3342"
                                              Offset="0" />

                                <GradientStop Color="#AA1B222D"
                                              Offset="1" />

                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid>

                            <!-- Character profile image -->
                            <Ellipse x:Name="ChatCharacterImage"
                                     Width="50"
                                     Height="50"
                                     HorizontalAlignment="Left"
                                     RenderOptions.BitmapScalingMode="HighQuality"
                                     VerticalAlignment="Center">

                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="/CharImg/mira_profile.png"
                                                Stretch="UniformToFill" />
                                </Ellipse.Fill>

                            </Ellipse>

                            <!-- Character information -->
                            <StackPanel Margin="65,0,0,0"
                                        VerticalAlignment="Center">

                                <TextBlock x:Name="ChatCharacterName"
                                           Text="MIRA"
                                           Foreground="#E8ECF2"
                                           FontSize="17"
                                           FontWeight="SemiBold" />

                            </StackPanel>

                        </Grid>

                    </Border>



                    <!-- MESSAGES -->
                    <ScrollViewer x:Name="ChatScrollViewer"
                                  Grid.Row="1"
                                  Margin="0,15,0,15"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">



                        <ScrollViewer.Resources>

                            <Style TargetType="{x:Type ScrollBar}">

                                <!-- Actual scrollbar thickness -->
                                <Setter Property="Width"
                                        Value="5" />

                                <Setter Property="MinWidth"
                                        Value="5" />

                                <Setter Property="MaxWidth"
                                        Value="5" />

                                <Setter Property="Background"
                                        Value="Transparent" />

                                <Setter Property="BorderThickness"
                                        Value="0" />

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="{x:Type ScrollBar}">

                                            <Grid Width="5"
                                                  Background="Transparent">

                                                <Track x:Name="PART_Track"
                                                       Width="5"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Stretch"
                                                       IsDirectionReversed="True">

                                                    <!-- TOP AREA -->
                                                    <Track.DecreaseRepeatButton>

                                                        <RepeatButton Command="ScrollBar.LineUpCommand"
                                                                      Background="Transparent"
                                                                      BorderThickness="0"
                                                                      IsTabStop="False"
                                                                      Height="0" />

                                                    </Track.DecreaseRepeatButton>


                                                    <!-- THUMB -->

                                                    <Track.Thumb>

