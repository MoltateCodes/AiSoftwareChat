<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Character"
        Width="1200"
        Height="750"
        Background="#101318"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#101318">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="121*"/>
            <ColumnDefinition Width="179*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0"
                Background="#171B22"
                BorderBrush="#252B35"
                BorderThickness="0,0,0,1" Grid.ColumnSpan="2">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="AI CHARACTER"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Interactive AI Companion"
                               Foreground="#7F8998"
                               FontSize="12"
                               Margin="0,2,0,0"/>

                </StackPanel>

                <Button Grid.Column="1"
                        Width="42"
                        Height="42"
                        Content="⚙"
                        FontSize="20"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"/>

            </Grid>

        </Border>


        <!-- MAIN AREA -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="55*"/>
                <ColumnDefinition Width="45*"/>
            </Grid.ColumnDefinitions>


            <!-- CHARACTER PANEL -->
            <Border Grid.Column="0"
                    Background="#12161D"
                    Margin="15"
                    CornerRadius="15">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <Border Width="350"
                            Height="450"
                            Background="#181D26"
                            CornerRadius="20">

                        <TextBlock Text="2D CHARACTER"
                                   Foreground="#596273"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <TextBlock Text="MIRA"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,15,0,0"/>

                    <TextBlock Text="Neutral"
                               Foreground="#7F8998"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>

                </StackPanel>

            </Border>


            <!-- CHAT PANEL -->
            <Border Grid.Column="1"
                    Background="#171B22"
                    Margin="0,15,15,15"
                    CornerRadius="15">

                <Grid Margin="20">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="70"/>
                    </Grid.RowDefinitions>


                    <!-- CHARACTER STATUS -->
                    <Border Grid.Row="0"
                            Background="#1D232D"
                            CornerRadius="10"
                            Padding="15">

                        <StackPanel>

                            <TextBlock Text="MIRA"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Online"
                                       Foreground="#70C090"
                                       FontSize="12"
                                       Margin="0,3,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- MESSAGES -->
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,15,0,15"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <Border Background="#242A35"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="0,0,40,10">

                                <TextBlock Text="Hello! I'm Mira. How are you?"
                                           Foreground="#E8ECF2"
                                           FontSize="14"
                                           TextWrapping="Wrap"/>

                            </Border>

                            <Border Background="#33445A"
                                    CornerRadius="12"
                                    Padding="14"
                                    HorizontalAlignment="Right"
                                    Margin="40,0,0,10">

                                <TextBlock Text="Hello! I'm doing great."
                                           Foreground="White"
                                           FontSize="14"
                                           TextWrapping="Wrap"/>

                            </Border>

                            <Border Background="#242A35"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="0,0,40,10">

                                <TextBlock Text="That's nice to hear!"
                                           Foreground="#E8ECF2"
                                           FontSize="14"
                                           TextWrapping="Wrap"/>

                            </Border>

                        </StackPanel>

                    </ScrollViewer>


                    <!-- INPUT -->
                    <Border Grid.Row="2"
                            Background="#1D232D"
                            CornerRadius="12"
                            Padding="8">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="MessageInput"
                                     Text="Type a message..."
                                     Background="Transparent"
                                     Foreground="#AAB2BF"
                                     BorderThickness="0"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Padding="10"/>

                            <Button Grid.Column="1"
                                    Content="➤"
                                    FontSize="20"
                                    Background="#3B82F6"
                                    Foreground="White"
                                    BorderThickness="0"/>

                        </Grid>

                    </Border>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>