<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1200"
        Height="750"
        Background="#101318"
        FontFamily="Pally Variable"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <Grid Background="#101318">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="35*" />
            <ColumnDefinition Width="45*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0"
                Background="#171B22"
                BorderBrush="#252B35"
                BorderThickness="0,0,0,1"
                Grid.ColumnSpan="3">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Welcome to Dimension Solaria"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="SemiBold" />

                    <TextBlock Text="FROM MOLTATE WORLD"
                               Foreground="#7F8998"
                               FontSize="12"
                               Margin="0,2,0,0" />

                </StackPanel>

                <Button Grid.Column="1"
                        Width="42"
                        Height="42"
                        Content="⚙"
                        FontSize="20"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0" />

            </Grid>

        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Row="1"
              Grid.ColumnSpan="3">

            <Grid.ColumnDefinitions>
                <!-- Character list -->
                <ColumnDefinition Width="220" />

                <!-- 2D Character -->
                <ColumnDefinition Width="35*" />

                <!-- Chat -->
                <ColumnDefinition Width="45*" />

            </Grid.ColumnDefinitions>

            <!-- CHARACTER LIST -->
            <Border Grid.Column="0"
                    Background="#12161D"
                    Margin="15"
                    CornerRadius="15">

                <Grid Margin="12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>


                    <!-- TITLE -->
                    <TextBlock Text="CHARACTERS"
                               Foreground="#7F8998"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="8,5,0,15" />


                    <!-- CHARACTER LIST -->
                    <StackPanel Grid.Row="1">


                        <!-- MIRA -->
                        <Border x:Name="MiraCharacterBorder"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="35"
                                RenderTransformOrigin="0.5,0.5"
                                Padding="10"
                                Margin="0,0,0,8"
                                Tag="MIRA"
                                Cursor="Hand"
                                MouseLeftButtonUp="Character_Click">

                           

                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1"
                                                ScaleY="1" />
                            </Border.RenderTransform>

                            <Border.Style>
                                <Style TargetType="Border">

                                    <!-- NORMAL -->
                                    <Setter Property="Background"
                                            Value="Transparent" />

                                    <Style.Triggers>

                                        <!-- HOVER: SCALE UP -->
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- MOUSE LEAVES: SCALE BACK -->
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- CLICK: PRESS DOWN -->
                                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="0.94"
                                                                     Duration="0:0:0.08" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="0.94"
                                                                     Duration="0:0:0.08" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- CLICK: RELEASE -->
                                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Border.Style>

                            <Grid>

                                <Ellipse Width="50"
                                         Height="50"
                                         RenderOptions.BitmapScalingMode="HighQuality"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center">

                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/CharImg/mira_profile.png"
                                                    Stretch="UniformToFill" />
                                    </Ellipse.Fill>

                                </Ellipse>

                                <StackPanel Margin="55,0,0,0"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="MIRA"
                                               Foreground="#E8ECF2"
                                               FontSize="14"
                                               FontWeight="SemiBold" />

                                    <TextBlock Text="Online"
                                               Foreground="#6EE7A8"
                                               FontSize="11" />

                                </StackPanel>

                            </Grid>

                        </Border>


                        <!-- BYTE -->
                        <Border BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="35"
                                RenderTransformOrigin="0.5,0.5"
                                Padding="10"
                                Margin="0,0,0,8"
                                Tag="BYTE"
                                Cursor="Hand"
                                MouseLeftButtonUp="Character_Click">
                            
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1"
                                                ScaleY="1" />
                                
                            </Border.RenderTransform>

                            <Border.Style>
                                <Style TargetType="Border">

                                    <!-- NORMAL -->
                                    <Setter Property="Background"
                                            Value="Transparent" />

                                    <Style.Triggers>

                                        <!-- HOVER: SCALE UP -->
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- MOUSE LEAVES: SCALE BACK -->
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- CLICK: PRESS DOWN -->
                                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="0.94"
                                                                     Duration="0:0:0.08" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="0.94"
                                                                     Duration="0:0:0.08" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- CLICK: RELEASE -->
                                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Border.Style>


                            <Grid>

                                <Ellipse Width="42"
                                         Height="42"
                                         RenderOptions.BitmapScalingMode="HighQuality"
                                         HorizontalAlignment="Left">

                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/CharImg/byte_profile.png"
                                                    Stretch="UniformToFill" />
                                    </Ellipse.Fill>

                                </Ellipse>

                                <StackPanel Margin="55,0,0,0"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="BYTE"
                                               Foreground="White"
                                               FontSize="14"
                                               FontWeight="SemiBold" />

                                    <TextBlock Text="Online"
                                               Foreground="#6EE7A8"
                                               FontSize="11" />

                                </StackPanel>

                            </Grid>

                        </Border>

                        <!-- NIX -->
                        <Border BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="35"
                                RenderTransformOrigin="0.5,0.5"
                                Padding="10"
                                Margin="0,0,0,8"
                                Tag="NIX"
                                Cursor="Hand"
                                MouseLeftButtonUp="Character_Click">

                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1"
                                                ScaleY="1" />
                            </Border.RenderTransform>

                            <Border.Style>
                                <Style TargetType="Border">

                                    <!-- NORMAL -->
                                    <Setter Property="Background"
                                            Value="Transparent" />

                                    <Style.Triggers>

                                        <!-- HOVER: SCALE UP -->
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- MOUSE LEAVES: SCALE BACK -->
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- CLICK: PRESS DOWN -->
                                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="0.94"
                                                                     Duration="0:0:0.08" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="0.94"
                                                                     Duration="0:0:0.08" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- CLICK: RELEASE -->
                                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Border.Style>


                            <Grid>

                                <Ellipse Width="42"
                                         Height="42"
                                         RenderOptions.BitmapScalingMode="HighQuality"
                                         HorizontalAlignment="Left">

                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/CharImg/nix_profile.png"
                                                    Stretch="UniformToFill" />
                                    </Ellipse.Fill>

                                </Ellipse>

                                <StackPanel Margin="55,0,0,0"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="NIX"
                                               Foreground="White"
                                               FontSize="14"
                                               FontWeight="SemiBold" />

                                    <TextBlock Text="Online"
                                               Foreground="#6EE7A8"
                                               FontSize="11" />

                                </StackPanel>

                            </Grid>

                        </Border>

                        <!-- R-01 -->
                        <Border BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="35"
                                RenderTransformOrigin="0.5,0.5"
                                Padding="10"
                                Margin="0,0,0,8"
                                Tag="R-01"
                                Cursor="Hand"
                                MouseLeftButtonUp="Character_Click">

                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1"
                                                ScaleY="1" />
                            </Border.RenderTransform>

                            <Border.Style>
                                <Style TargetType="Border">

                                    <!-- NORMAL -->
                                    <Setter Property="Background"
                                            Value="Transparent" />

                                    <Style.Triggers>

                                        <!-- HOVER: SCALE UP -->
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- MOUSE LEAVES: SCALE BACK -->
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- CLICK: PRESS DOWN -->
                                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="0.94"
                                                                     Duration="0:0:0.08" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="0.94"
                                                                     Duration="0:0:0.08" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>


                                        <!-- CLICK: RELEASE -->
                                        <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                            <BeginStoryboard>
                                                <Storyboard>

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                    <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1.04"
                                                                     Duration="0:0:0.12" />

                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Border.Style>


                            <Grid>

                                <Ellipse Width="42"
                                         Height="42"
                                         RenderOptions.BitmapScalingMode="HighQuality"
                                         HorizontalAlignment="Left">

                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/CharImg/R-01_profile.png"
                                                    Stretch="UniformToFill" />
                                    </Ellipse.Fill>

                                </Ellipse>

                                <StackPanel Margin="55,0,0,0"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="R-01"
                                               Foreground="White"
                                               FontSize="14"
                                               FontWeight="SemiBold" />

                                    <TextBlock Text="Online"
                                               Foreground="#6EE7A8"
                                               FontSize="11" />

                                </StackPanel>

                            </Grid>

                        </Border>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- CHARACTER PANEL -->
            <Border Grid.Column="1"
                    Background="#12161D"
                    Margin="15"
                    CornerRadius="35">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <Border Width="350"
                            Height="450"
                            Background="#181D26"
                            CornerRadius="20">

                        <TextBlock Text="2D CHARACTER"
                                   Foreground="#596273"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                    </Border>

                    <TextBlock x:Name="CenterCharacterName"
                               Text="MIRA"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,15,0,0" />

                    <TextBlock Text="Neutral"
                               Foreground="#7F8998"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />

                </StackPanel>

            </Border>

            <!-- CHAT PANEL -->
            <Border Grid.Column="2"
                    Background="#171B22"
                    Margin="0,15,15,15"
                    CornerRadius="35">

                <Grid Margin="20">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="70" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="70" />
                    </Grid.RowDefinitions>

                    <!-- CHARACTER STATUS -->


                    <Border Background="#1E2530"
                            CornerRadius="35"
                            Padding="10">

                        <Grid>

                            <!-- Character profile image -->
                            <Ellipse x:Name="ChatCharacterImage"
                                     Width="50"
                                     Height="50"
                                     HorizontalAlignment="Left"
                                     RenderOptions.BitmapScalingMode="HighQuality"
                                     VerticalAlignment="Center">

                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="/CharImg/mira_profile.png"
                                                Stretch="UniformToFill" />
                                </Ellipse.Fill>

                            </Ellipse>

                            <!-- Character information -->
                            <StackPanel Margin="65,0,0,0"
                                        VerticalAlignment="Center">

                                <TextBlock x:Name="ChatCharacterName"
                                           Text="MIRA"
                                           Foreground="#E8ECF2"
                                           FontSize="17"
                                           FontWeight="SemiBold" />

                            </StackPanel>

                        </Grid>

                    </Border>



                    <!-- MESSAGES -->
                    <ScrollViewer x:Name="ChatScrollViewer"
                                  Grid.Row="1"
                                  Margin="0,15,0,15"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <!-- ALL CHAT MESSAGES -->
                            <StackPanel x:Name="ChatMessages">
                            </StackPanel>

                            <!-- TYPING INDICATOR -->
                            <Border x:Name="TypingIndicator"
                                    Background="Transparent"
                                    Padding="12,7"
                                    Margin="0,0,40,8"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock x:Name="TypingCharacterName"
                                               Text="MIRA"
                                               Foreground="#949494"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Margin="0,0,6,0" />

                                    <TextBlock Text="is typing..."
                                               Foreground="#9CA3AF"
                                               FontSize="12" />

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </ScrollViewer>

                    <!-- INPUT -->
                    <Border Grid.Row="2"
                            Background="#1D232D"
                            CornerRadius="35"
                            Padding="8">

                        <Grid>


                            <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="11.2" />
                                    <ColumnDefinition Width="38.8" />
                                </Grid.ColumnDefinitions>

                                <!-- MESSAGE INPUT -->
                                <TextBox x:Name="MessageInput"
                                     Grid.Column="0"
                                     Background="Transparent"
                                     Foreground="#E8ECF2"
                                     CaretBrush="White"
                                     BorderThickness="0"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Padding="10"
                                     TextChanged="MessageInput_TextChanged"
                                     KeyDown="MessageInput_KeyDown" />
                                
                                <!-- PLACEHOLDER -->
                                
                                <TextBlock x:Name="MessagePlaceholder"
                                       Grid.Column="0"
                                       Text="Type a message..."
                                            Foreground="#6B7280"
                                            FontSize="14"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0"
                                            IsHitTestVisible="False" />
                            
                            <!-- SEND BUTTON -->

                            <Button x:Name="SendButton"
                                    Grid.Column="1"
                                    Width="45"
                                    Height="45"
                                    Content="➤"
                                    FontSize="20"
                                    Foreground="White"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Click="SendButton_Click"
                                    Grid.ColumnSpan="2"
                                    Margin="3,4,2,4">

                                <Button.RenderTransform>
                                    <ScaleTransform x:Name="SendButtonScale"
                                                    ScaleX="1"
                                                    ScaleY="1" />
                                </Button.RenderTransform>

                                <Button.RenderTransformOrigin>
                                    0.5,0.5
                                </Button.RenderTransformOrigin>

                                <Button.Style>
                                    <Style TargetType="Button">

                                        <Style.Triggers>

                                            <!-- Mouse pressed -->
                                            <EventTrigger RoutedEvent="PreviewMouseDown">
                                                <BeginStoryboard>
                                                    <Storyboard>

                                                        <DoubleAnimation
                                                                Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                         To="0.82"
                                                                         Duration="0:0:0.08" />

                                                        <DoubleAnimation
                                                                Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                         To="0.82"
                                                                         Duration="0:0:0.08" />

                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>

                                            <!-- Mouse released -->
                                            <EventTrigger RoutedEvent="PreviewMouseUp">
                                                <BeginStoryboard>
                                                    <Storyboard>

                                                        <DoubleAnimation
                                                                Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                         To="1"
                                                                         Duration="0:0:0.12" />

                                                        <DoubleAnimation
                                                                Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                         To="1"
                                                                         Duration="0:0:0.12" />

                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>

                                        </Style.Triggers>

                                    </Style>
                                </Button.Style>


                                <Button.Template>
                                    <ControlTemplate TargetType="Button">

                                        <Border x:Name="ButtonBorder"
                                                Width="45"
                                                Height="45"
                                                CornerRadius="35">

                                            <Border.Background>
                                                <SolidColorBrush x:Name="HoverBrush"
                                                                 Color="Transparent" />
                                            </Border.Background>

                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <!-- MOUSE ENTER -->
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>

                                                        <ColorAnimation Storyboard.TargetName="HoverBrush"
                                                                        Storyboard.TargetProperty="Color"
                                                                        From="Transparent"
                                                                        To="#555555"
                                                                        Duration="0:0:0.25" />

                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>


                                            <!-- MOUSE LEAVE -->
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>

                                                        <ColorAnimation Storyboard.TargetName="HoverBrush"
                                                                        Storyboard.TargetProperty="Color"
                                                                        From="#555555"
                                                                        To="Transparent"
                                                                        Duration="0:0:0.25" />

                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>
                                </Button.Template>

                            </Button>
                        </Grid>

                    </Border>

                </Grid>

            </Border>

